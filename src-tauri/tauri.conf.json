{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smart Files AI",
  "version": "0.1.0",
  "identifier": "com.smartfile.ai",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:3001",
    "frontendDist": "../out"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../backend/*.py",
      "../backend/agents/**/*",
      "../backend/core/**/*",
      "../backend/models/**/*",
      "../backend/routes/**/*",
      "../backend/services/**/*",
      "../backend/memory/**/*",
      "../backend/requirements.txt"
    ],
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "Smart Files AI",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
